<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/card_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌐 CONNECT VIA WI-FI / ETHERNET LAN"
            android:textColor="@color/sunmi_orange"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Standard RAW ESC/POS Socket (Port 9100) · NT311 / NT312 / NT211"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            android:layout_marginBottom="8dp" />

        <!-- Current Local Network Telemetry -->
        <TextView
            android:id="@+id/tvLocalNetworkInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="cPad IP: Detecting..."
            android:textColor="#38BDF8"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:background="#0A0E17"
            android:padding="6dp"
            android:layout_marginBottom="12dp" />

        <!-- Section 1: SunmiPrinter Setup Added Printers -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="PRINTERS FROM SUNMIPRINTER SETUP"
                android:textColor="@color/sunmi_orange"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />

            <Button
                android:id="@+id/btnToggleAddPrinter"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:text="➕ Add from Setup"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:backgroundTint="#0284C7"
                android:paddingLeft="8dp"
                android:paddingRight="8dp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap any printer below to load IP and connect immediately:"
            android:textColor="@color/text_muted"
            android:textSize="10sp"
            android:layout_marginBottom="6dp" />

        <!-- Saved / Added Printers ListView -->
        <ListView
            android:id="@+id/lvSavedPrinters"
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:background="#0A0E17"
            android:divider="#1E293B"
            android:dividerHeight="1dp"
            android:padding="4dp"
            android:layout_marginBottom="10dp" />

        <!-- Expandable Form: Add / Register Printer from Sunmi Setup -->
        <LinearLayout
            android:id="@+id/layoutAddPrinterForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#0F172A"
            android:padding="10dp"
            android:layout_marginBottom="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="REGISTER PRINTER CONFIGURED IN SUNMIPRINTER SETUP:"
                android:textColor="#FBBF24"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <!-- Model & SN row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp">

                <EditText
                    android:id="@+id/etNewPrinterModel"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:hint="Model (e.g. NT311)"
                    android:text="NT311"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:background="@drawable/bg_terminal"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:textSize="11sp"
                    android:layout_marginRight="6dp" />

                <EditText
                    android:id="@+id/etNewPrinterSn"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="2"
                    android:hint="SN (e.g. N402D05T00007)"
                    android:text="N402D05T00007"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:background="@drawable/bg_terminal"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:textSize="11sp"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <!-- IP, Port & Type row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <EditText
                    android:id="@+id/etNewPrinterIp"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="3"
                    android:hint="IP Address (e.g. 192.168.1.150)"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:background="@drawable/bg_terminal"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:inputType="textUri"
                    android:layout_marginRight="6dp" />

                <EditText
                    android:id="@+id/etNewPrinterPort"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:hint="9100"
                    android:text="9100"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:background="@drawable/bg_terminal"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:inputType="number" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnSavePrinterSubmit"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="💾 Save Printer &amp; Connect"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:backgroundTint="#059669"
                    android:layout_marginRight="6dp" />

                <Button
                    android:id="@+id/btnCancelAddPrinter"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Cancel"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:backgroundTint="#334155" />
            </LinearLayout>
        </LinearLayout>

        <!-- Section 2: Direct Target IP & Port -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TARGET PRINTER IP &amp; RAW PORT"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <EditText
                android:id="@+id/etPrinterIp"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="3"
                android:hint="192.168.103.134"
                android:text="192.168.103.134"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:background="@drawable/bg_terminal"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:inputType="textUri"
                android:layout_marginRight="8dp" />

            <EditText
                android:id="@+id/etPrinterPort"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:hint="9100"
                android:text="9100"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:background="@drawable/bg_terminal"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:inputType="number" />
        </LinearLayout>

        <!-- Section 3: Subnet Scanner -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <Button
                android:id="@+id/btnScanLan"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="🔍 Scan Subnet"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:backgroundTint="#0D9488"
                android:paddingLeft="10dp"
                android:paddingRight="10dp" />

            <ProgressBar
                android:id="@+id/pbScanProgress"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginLeft="10dp"
                android:indeterminate="true"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvScanStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="8dp"
                android:text=""
                android:textColor="@color/text_muted"
                android:textSize="10sp"
                android:fontFamily="monospace" />
        </LinearLayout>

        <ListView
            android:id="@+id/lvDiscoveredPrinters"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:background="#0A0E17"
            android:divider="#1E293B"
            android:dividerHeight="1dp"
            android:padding="4dp"
            android:layout_marginBottom="12dp" />

        <!-- Dialog Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnConnectLanSubmit"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:text="Connect (Wi-Fi/LAN)"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:backgroundTint="#0D9488"
                android:layout_marginRight="6dp" />

            <Button
                android:id="@+id/btnCancelLan"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:text="Close"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:backgroundTint="#1E293B" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
