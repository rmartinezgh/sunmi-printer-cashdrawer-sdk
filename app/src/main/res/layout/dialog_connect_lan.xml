<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/card_bg"
    android:padding="18dp">

    <!-- Header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🌐 CONNECT VIA WI-FI / ETHERNET LAN"
        android:textColor="@color/sunmi_orange"
        android:textSize="14sp"
        android:textStyle="bold"
        android:letterSpacing="0.05" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Standard RAW ESC/POS Socket (Port 9100) on NT311 / NT312"
        android:textColor="@color/text_muted"
        android:textSize="11sp"
        android:layout_marginBottom="12dp" />

    <!-- IP & Port Inputs -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp">

        <!-- IP Address -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="3"
            android:orientation="vertical"
            android:layout_marginRight="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PRINTER IP ADDRESS"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />

            <EditText
                android:id="@+id/etPrinterIp"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:hint="192.168.103.134"
                android:text="192.168.103.134"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:background="@drawable/bg_terminal"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:inputType="textUri" />
        </LinearLayout>

        <!-- Port Number -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PORT"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />

            <EditText
                android:id="@+id/etPrinterPort"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:hint="9100"
                android:text="9100"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:background="@drawable/bg_terminal"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:inputType="number" />
        </LinearLayout>

    </LinearLayout>

    <!-- Scan Subnet Button & Progress -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btnScanLan"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="🔍 Scan Network (Port 9100)"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:backgroundTint="#0D9488"
            android:paddingLeft="10dp"
            android:paddingRight="10dp" />

        <ProgressBar
            android:id="@+id/pbScanProgress"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginLeft="10dp"
            android:indeterminate="true"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvScanStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="8dp"
            android:text=""
            android:textColor="@color/text_muted"
            android:textSize="10sp"
            android:fontFamily="monospace" />
    </LinearLayout>

    <!-- Discovered Printers List -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DISCOVERED NETWORK PRINTERS"
        android:textColor="@color/text_muted"
        android:textSize="10sp"
        android:fontFamily="monospace"
        android:layout_marginBottom="4dp" />

    <ListView
        android:id="@+id/lvDiscoveredPrinters"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="@drawable/bg_terminal"
        android:divider="#1E293B"
        android:dividerHeight="1dp"
        android:padding="4dp"
        android:layout_marginBottom="12dp" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnConnectLanSubmit"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:text="Connect (Wi-Fi/LAN)"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:backgroundTint="#0D9488"
            android:layout_marginRight="6dp" />

        <Button
            android:id="@+id/btnCancelLan"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:text="Cancel"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:backgroundTint="#1E293B" />
    </LinearLayout>

</LinearLayout>
