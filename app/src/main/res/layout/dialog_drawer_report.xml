<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/card_bg"
    android:padding="16dp">

    <!-- Dialog Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📊 CASH DRAWER AUDIT REPORT"
            android:textColor="@color/sunmi_orange"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.04" />

        <TextView
            android:id="@+id/tvReportGeneratedAt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2026-11-18 23:00"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            android:fontFamily="monospace" />
    </LinearLayout>

    <!-- KPI Summary Grid (4 Cards) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <!-- Total Opens -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/bg_terminal"
            android:padding="8dp"
            android:layout_marginRight="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TOTAL OPENS"
                android:textColor="@color/text_muted"
                android:textSize="10sp"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/tvReportOpens"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/sunmi_orange"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Total Closes -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/bg_terminal"
            android:padding="8dp"
            android:layout_marginRight="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CLOSES"
                android:textColor="@color/text_muted"
                android:textSize="10sp"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/tvReportCloses"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#34D399"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Overtime Alerts -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/bg_terminal"
            android:padding="8dp"
            android:layout_marginRight="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OVERTIME ALERTS"
                android:textColor="@color/text_muted"
                android:textSize="10sp"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/tvReportAlerts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#F87171"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Avg Open Duration -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/bg_terminal"
            android:padding="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AVG DURATION"
                android:textColor="@color/text_muted"
                android:textSize="10sp"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/tvReportAvgDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.0s"
                android:textColor="#38BDF8"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

    <!-- Sub-Metrics Ribbon -->
    <TextView
        android:id="@+id/tvReportSubMetrics"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Kicks: BT=0, Cloud=0, Manual=0 | Sensor: Inverted (N.C.)"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:layout_marginBottom="10dp" />

    <!-- Formatted Report Scrollable Preview -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="@drawable/bg_terminal"
        android:padding="10dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tvReportFullText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/terminal_text"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:lineSpacingExtra="2dp" />
    </ScrollView>

    <!-- Action Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Print to NT311 -->
        <Button
            android:id="@+id/btnPrintReportBt"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:text="🖨️ Print NT311"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:backgroundTint="@color/sunmi_orange"
            android:layout_marginRight="4dp" />

        <!-- Share / Export -->
        <Button
            android:id="@+id/btnShareReport"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:text="📤 Share"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:backgroundTint="#2563EB"
            android:layout_marginRight="4dp" />

        <!-- Copy -->
        <Button
            android:id="@+id/btnCopyReportText"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:text="📋 Copy"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:backgroundTint="#334155"
            android:layout_marginRight="4dp" />

        <!-- Close -->
        <Button
            android:id="@+id/btnCloseReport"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:text="Close"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:backgroundTint="#1E293B" />
    </LinearLayout>

</LinearLayout>
